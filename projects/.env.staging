# MekongPulse - staging preset (local Docker Compose stack against pg_db).
# Switch with:  ./scripts/switch_env.sh staging
ENVIRONMENT=staging
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mekongpulse_staging
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
LOG_SALT=REPLACE_ME_staging_salt

# Secrets: keep placeholders locally; the deployer injects real values.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BROADCAST_CHANNEL_ID=
# GEMINI_API_KEY=
# ADMIN_TOKEN=
