# MekongPulse - production preset (Firestore + GCS on Google Cloud Run).
# Switch with:  ./scripts/switch_env.sh production
ENVIRONMENT=production
FIRESTORE_PROJECT=ai-builder-cup-511603
GCS_BUCKET=REPLACE_ME_mekongpulse_audio
GCS_PUBLIC_BASE=https://storage.googleapis.com/REPLACE_ME_mekongpulse_audio
PUBLIC_BASE_URL=REPLACE_ME_cloud_run_backend_url
CORS_ORIGINS=REPLACE_ME_cloud_run_frontend_url
LOG_SALT=REPLACE_ME_production_salt
USE_VERTEX_AI=true
VERTEX_PROJECT=ai-builder-cup-511603
VERTEX_LOCATION=asia-southeast1

# Secrets injected by scripts/deploy_gcp.sh from Secret Manager:
# TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_BROADCAST_CHANNEL_ID
# ADMIN_TOKEN
