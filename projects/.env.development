# MekongPulse - development preset (local Postgres via the shared pg_db container).
# Switch with:  ./scripts/switch_env.sh development
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mekongpulse
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
LOG_SALT=mekongpulse-dev-salt

# Drop real keys in to go live; leave commented for mock mode.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BROADCAST_CHANNEL_ID=
# GEMINI_API_KEY=
# ADMIN_TOKEN=
